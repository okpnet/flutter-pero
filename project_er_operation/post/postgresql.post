// @post name=PostgreSQL targetDb=postgresql apiVersion=4
//
// PERO 同梱のポストファイル(PostgreSQL用)。生成用JSON(apiVersion 4)からSQLを作る。
// 出力順: 開始クエリ → スキーマ → ユーザー定義型 → ファンクション → テーブル(依存するファンクションを直後に)
//         → 外部キー → ビュー → トリガー → 終了クエリ
//
// トリガーの本体の規約:
//   公開(public)のメソッド: 本体は「トリガー関数を定義するSQL」。ポストファイルは同じメソッドを1回だけ出力し、
//                          `EXECUTE FUNCTION <メソッド名>()` で参照する。
//   入力(inline): 本体は「トリガー関数を定義するSQL」で、関数名を `{{trigger}}` にする。
//                 `EXECUTE FUNCTION <トリガー名>()` で参照する。
function main(jsonText) {
  var m = JSON.parse(jsonText);
  var out = [];

  var RESERVED = ('all analyse analyze and any array as asc asymmetric both case cast check collate column ' +
    'constraint create current_catalog current_date current_role current_time current_timestamp current_user ' +
    'default deferrable desc distinct do else end except false fetch for foreign from grant group having in ' +
    'initially intersect into lateral leading limit localtime localtimestamp not null offset on only or order ' +
    'placing primary references returning select session_user some symmetric system_user table then to ' +
    'trailing true union unique user using variadic when where window with').split(' ');

  function q(name) {
    if (/^[a-z_][a-z0-9_]*$/.test(name) && RESERVED.indexOf(name) < 0) return name;
    return '"' + name.replace(/"/g, '""') + '"';
  }
  function lit(s) { return "'" + String(s).replace(/'/g, "''") + "'"; }
  function qt(schema, name) { return schema ? q(schema) + '.' + q(name) : q(name); }
  var drop = m.model.dropBeforeCreate === true;
  function list(names) { return names.map(q).join(', '); }

  // CHECK制約。式(mode=expression)はそのまま、条件(mode=conditions)は列の型(typeCategory)に合わせて値を書く(6.4-6)。
  var BOOL_TRUE = 'true', BOOL_FALSE = 'false';
  var CHECK_OPS = { eq: '=', ne: '<>', lt: '<', le: '<=', gt: '>', ge: '>=' };
  function checkValue(c, v) {
    var s = String(v).trim();
    if (c.typeCategory === 'number' || c.typeCategory === 'auto') return s;
    if (c.typeCategory === 'boolean') return /^(true|1)$/i.test(s) ? BOOL_TRUE : BOOL_FALSE;
    return lit(v);
  }
  function checkSql(k) {
    if (k.mode !== 'conditions') return k.expression;
    return k.conditions.map(function (c) {
      var col = q(c.column);
      var vs = c.values.map(function (v) { return checkValue(c, v); });
      switch (c.operator) {
        case 'in': return col + ' IN (' + vs.join(', ') + ')';
        case 'not_in': return col + ' NOT IN (' + vs.join(', ') + ')';
        case 'between': return col + ' BETWEEN ' + vs[0] + ' AND ' + vs[1];
        case 'like': return col + ' LIKE ' + lit(c.values[0]);
        case 'not_like': return col + ' NOT LIKE ' + lit(c.values[0]);
        case 'is_null': return col + ' IS NULL';
        case 'is_not_null': return col + ' IS NOT NULL';
        default: return col + ' ' + CHECK_OPS[c.operator] + ' ' + vs[0];
      }
    }).join(' ' + k.join + ' ');
  }
  function endSemi(s) {
    var t = s.replace(/\s+$/, '');
    return /;$/.test(t) ? t : t + ';';
  }
  function push(s) { if (s !== null && s !== undefined && String(s).replace(/\s+/g, '') !== '') out.push(String(s).replace(/\s+$/, '')); }

  function defaultText(c) {
    var d = c.default;
    if (d.kind === 'method') return d.call;
    if (d.kind === 'expression') return d.expression;
    if (d.kind !== 'value') return null;
    switch (c.typeCategory) {
      case 'number':
      case 'boolean':
      case 'auto':
        return d.value;
      default:
        return lit(d.value);
    }
  }

  var methodByName = {};
  m.methods.forEach(function (f) { methodByName[f.name] = f; });

  function emitFunction(f) {
    push(endSemi(f.body));
    if (f.comment) {
      push('COMMENT ON FUNCTION ' + qt(f.schema, f.name) + '(' + f.args + ') IS ' + lit(f.comment) + ';');
    }
  }

  // 1. 開始クエリ
  push(m.model.startQuery);

  // 2. スキーマ
  (m.schemas || []).forEach(function (s) { push('CREATE SCHEMA IF NOT EXISTS ' + q(s) + ';'); });

  // 3. ユーザー定義型(複合型、列挙型)
  m.userTypes.forEach(function (t) {
    var tn = qt(t.schema, t.name);
    if (drop) push('DROP TYPE IF EXISTS ' + tn + ' CASCADE;');
    if (t.kind === 'composite') {
      push('CREATE TYPE ' + tn + ' AS (' + t.fields.map(function (f) { return q(f.name) + ' ' + f.type; }).join(', ') + ');');
    } else {
      push('CREATE TYPE ' + tn + ' AS ENUM (' + t.values.map(lit).join(', ') + ');');
    }
    if (t.comment) push('COMMENT ON TYPE ' + tn + ' IS ' + lit(t.comment) + ';');
  });

  // 4. ファンクション(定義の本体があり、外部定義でないもの。依存テーブルのあるものはテーブルの後)
  function definable(f) { return f.kind === 'function' && !f.external && f.body.replace(/\s+/g, '') !== ''; }
  function unset(x) { return x === null || x === undefined; }
  m.methods.forEach(function (f) {
    if (definable(f) && unset(f.afterTableId) && unset(f.afterViewId)) emitFunction(f);
  });

  // 5. テーブル(依存順)
  m.tables.forEach(function (t) {
    var name = qt(t.schema, t.physicalName);
    push(t.preQuery);
    if (drop) push('DROP TABLE IF EXISTS ' + name + ' CASCADE;');
    var lines = t.columns.map(function (c) {
      var s = '  ' + q(c.physicalName) + ' ' + c.type;
      var d = defaultText(c);
      if (d !== null && d !== '') s += ' DEFAULT ' + d;
      if (c.notNull) s += ' NOT NULL';
      return s;
    });
    if (t.primaryKey) {
      lines.push('  CONSTRAINT ' + q(t.primaryKey.name) + ' PRIMARY KEY (' + list(t.primaryKey.columns) + ')');
    }
    t.checks.forEach(function (k) {
      lines.push('  CONSTRAINT ' + q(k.name) + ' CHECK (' + checkSql(k) + ')');
    });
    push('CREATE TABLE ' + name + ' (\n' + lines.join(',\n') + '\n);');
    t.indexes.forEach(function (i) {
      push('CREATE INDEX ' + q(i.name) + ' ON ' + name + ' (' + list(i.columns) + ');');
    });
    t.uniques.forEach(function (u) {
      push('ALTER TABLE ' + name + ' ADD CONSTRAINT ' + q(u.name) + ' UNIQUE' +
        (u.nullsNotDistinct ? ' NULLS NOT DISTINCT' : '') + ' (' + list(u.columns) + ');');
    });
    if (t.comment) push('COMMENT ON TABLE ' + name + ' IS ' + lit(t.comment) + ';');
    t.columns.forEach(function (c) {
      if (c.comment) push('COMMENT ON COLUMN ' + name + '.' + q(c.physicalName) + ' IS ' + lit(c.comment) + ';');
    });
    push(t.postQuery);
    m.methods.forEach(function (f) {
      if (definable(f) && f.afterTableId === t.id) emitFunction(f);
    });
  });

  // 6. 外部キー(deferred を含め、すべてのテーブルの作成後に出力する)
  m.foreignKeys.forEach(function (f) {
    var s = 'ALTER TABLE ' + qt(f.childSchema, f.childTable) + ' ADD CONSTRAINT ' + q(f.name) +
      ' FOREIGN KEY (' + list(f.columns.map(function (c) { return c.child; })) + ')' +
      ' REFERENCES ' + qt(f.parentSchema, f.parentTable) + ' (' + list(f.columns.map(function (c) { return c.parent; })) + ')';
    if (f.onDelete) s += ' ON DELETE ' + f.onDelete;
    if (f.onUpdate) s += ' ON UPDATE ' + f.onUpdate;
    if (f.deferrable) s += ' ' + f.deferrable;
    push(s + ';');
  });

  // 7. ビュー
  function qualified(expr) {
    var i = expr.indexOf('.');
    return i < 0 ? q(expr) : q(expr.substring(0, i)) + '.' + q(expr.substring(i + 1));
  }
  m.views.forEach(function (v) {
    var name = qt(v.schema, v.physicalName);
    push(v.preQuery);
    var body;
    if (v.viewType === 'sql') {
      body = String(v.sql).replace(/[\s;]+$/, '');
    } else if (v.viewType === 'function') {
      body = 'SELECT * FROM ' + (v.function.schema ? v.function.schema + '.' : '') + v.function.name + '(' + v.function.args.join(', ') + ')';
    } else {
      body = 'SELECT ' + v.columns.map(function (c) { return qualified(c.expr) + ' AS ' + q(c.name); }).join(', ') +
        '\nFROM ' + qt(v.from.schema, v.from.table) + ' ' + q(v.from.alias);
      v.joins.forEach(function (j) {
        body += '\n' + j.type + ' JOIN ' + qt(j.schema, j.table) + ' ' + q(j.alias) + ' ON ' +
          j.on.map(function (o) { return qualified(o.left) + ' = ' + qualified(o.right); }).join(' AND ');
      });
      if (v.where) body += '\nWHERE ' + v.where;
    }
    if (drop) push('DROP VIEW IF EXISTS ' + name + ';');
    push('CREATE VIEW ' + name + ' AS\n' + body + ';');
    if (v.comment) push('COMMENT ON VIEW ' + name + ' IS ' + lit(v.comment) + ';');
    push(v.postQuery);
    m.methods.forEach(function (f) {
      if (definable(f) && f.afterViewId === v.id) emitFunction(f);
    });
  });

  // 8. トリガー
  var emitted = {};
  m.tables.forEach(function (t) {
    t.triggers.forEach(function (g) {
      var fn = g.name;
      if (g.methodName !== null) {
        fn = g.methodName;
        if (!emitted[fn]) {
          emitted[fn] = true;
          var f = methodByName[fn];
          push(endSemi(g.body));
          if (f && f.comment) push('COMMENT ON FUNCTION ' + qt(f.schema, fn) + '(' + f.args + ') IS ' + lit(f.comment) + ';');
        }
      } else {
        push(endSemi(g.body));
      }
      var events = g.events.map(function (e) {
        return e === 'UPDATE' && g.updateColumns.length > 0 ? 'UPDATE OF ' + list(g.updateColumns) : e;
      });
      var s = 'CREATE TRIGGER ' + q(g.name) + ' ' + g.timing + ' ' + events.join(' OR ') +
        ' ON ' + qt(t.schema, t.physicalName) + ' FOR EACH ' + g.forEach;
      if (g.when) s += ' WHEN (' + g.when + ')';
      push(s + ' EXECUTE FUNCTION ' + (g.methodName !== null ? qt(g.methodSchema, fn) : q(fn)) + '(' + g.args + ');');
    });
  });

  // 9. 終了クエリ
  push(m.model.endQuery);

  return out.join('\n\n') + '\n';
}
